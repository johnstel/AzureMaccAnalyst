@page "/"
@rendermode InteractiveServer
@using AzureMaccAnalyst.Models
@using AzureMaccAnalyst.Services
@inject FileLoaderService Loader
@inject AnalysisService Analysis
@inject DemoDataService DemoData
@inject DashboardState State
@inject ILogger<Dashboard> Logger

<PageTitle>Azure MACC Analyst</PageTitle>

<!-- ═══════════ HEADER ═══════════ -->
<div class="dashboard-header">
    <h2>📊&nbsp; Azure Cost &amp; Commitment Dashboard</h2>
    <span class="header-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
</div>

<!-- ═══════════ STEP 1 — File Upload ═══════════ -->
<hr class="section-divider" />
<section class="section">
    <h3>1 &nbsp;&nbsp; Invoice Export</h3>
    <p class="section-caption">Upload your Azure invoice-detail CSV or Excel file. Large files (5 GB+) are streamed and memory-safe.</p>

    <div class="upload-bar">
        <InputFile OnChange="OnFileSelected" accept=".csv,.xlsx,.xls,.xlsm" class="form-control upload-input" id="invoiceFileInput" />
        <button class="btn btn-outline-secondary" type="button"
                onclick="document.getElementById('invoiceFileInput').click()">Browse…</button>
        <button class="btn btn-primary btn-analyze" @onclick="AnalyzeFile" disabled="@(State.IsLoading || State.Records.Count == 0)">
            @if (State.IsLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Analyze
        </button>
    </div>

    @if (!string.IsNullOrEmpty(State.FileName))
    {
        <small class="text-muted">Loaded: @State.FileName &nbsp;(@State.Records.Count.ToString("N0") records)</small>
    }

    @if (!string.IsNullOrEmpty(State.ErrorMessage))
    {
        <div class="alert alert-danger mt-2">@State.ErrorMessage</div>
    }
</section>

<!-- ═══════════ KPI Strip ═══════════ -->
@if (State.HasSummary)
{
    var s = State.Summary!;
    var ccy = s.Currency;
    <div class="kpi-strip">
        <div class="kpi-card"><label>Total Spend</label><div class="kpi-value">@ccy @s.TotalCost.ToString("N2")</div></div>
        <div class="kpi-card"><label>Line Items</label><div class="kpi-value">@s.RecordCount.ToString("N0")</div></div>
        <div class="kpi-card"><label>Period Start</label><div class="kpi-value">@(s.PeriodStart?.ToString("yyyy-MM-dd") ?? "—")</div></div>
        <div class="kpi-card"><label>Period End</label><div class="kpi-value">@(s.PeriodEnd?.ToString("yyyy-MM-dd") ?? "—")</div></div>
    </div>

    <!-- ═══════════ Pivot Tabs ═══════════ -->
    <hr class="section-divider" />
    <section class="section">
        <div class="tab-bar">
            <button class="tab-btn @(activeTab == "service" ? "active" : "")" @onclick='() => activeTab = "service"'>By Service</button>
            <button class="tab-btn @(activeTab == "subscription" ? "active" : "")" @onclick='() => activeTab = "subscription"'>By Subscription</button>
            <button class="tab-btn @(activeTab == "charge" ? "active" : "")" @onclick='() => activeTab = "charge"'>By Charge Type</button>
            <button class="tab-btn @(activeTab == "daily" ? "active" : "")" @onclick='() => activeTab = "daily"'>Daily Trend</button>
        </div>

        @if (State.Pivots is not null)
        {
            @if (activeTab == "service")
            {
                <div class="chart-table-row">
                    <div class="chart-col">
                        <BarChart Labels="@State.Pivots.CostByServiceFamily.Select(r => r.Label).ToArray()"
                                  Data="@State.Pivots.CostByServiceFamily.Select(r => r.TotalCost).ToArray()"
                                  ChartLabel="Cost by Service" />
                    </div>
                    <div class="table-col">
                        <PivotTable Rows="State.Pivots.CostByServiceFamily" LabelHeader="Service Family" Currency="@ccy" />
                    </div>
                </div>
            }
            else if (activeTab == "subscription")
            {
                <div class="chart-table-row">
                    <div class="chart-col">
                        <BarChart Labels="@State.Pivots.CostBySubscription.Select(r => r.Label).ToArray()"
                                  Data="@State.Pivots.CostBySubscription.Select(r => r.TotalCost).ToArray()"
                                  ChartLabel="Cost by Subscription" />
                    </div>
                    <div class="table-col">
                        <PivotTable Rows="State.Pivots.CostBySubscription" LabelHeader="Subscription" Currency="@ccy" />
                    </div>
                </div>
            }
            else if (activeTab == "charge")
            {
                <div class="chart-table-row">
                    <div class="chart-col">
                        <BarChart Labels="@State.Pivots.CostByChargeType.Select(r => r.Label).ToArray()"
                                  Data="@State.Pivots.CostByChargeType.Select(r => r.TotalCost).ToArray()"
                                  ChartLabel="Cost by Charge Type" />
                    </div>
                    <div class="table-col">
                        <PivotTable Rows="State.Pivots.CostByChargeType" LabelHeader="Charge Type" Currency="@ccy" />
                    </div>
                </div>
            }
            else if (activeTab == "daily")
            {
                <div class="chart-table-row">
                    <div class="chart-col">
                        <BarChart Labels="@State.Pivots.CostByDay.Select(r => r.Date.ToString("yyyy-MM-dd")).ToArray()"
                                  Data="@State.Pivots.CostByDay.Select(r => r.TotalCost).ToArray()"
                                  ChartLabel="Daily Cost"
                                  ChartType="line" />
                    </div>
                    <div class="table-col">
                        <DailyTrendTable Rows="State.Pivots.CostByDay" Currency="@ccy" />
                    </div>
                </div>
            }
        }
    </section>
}

<!-- ═══════════ STEP 2 — Demo Enrichment ═══════════ -->
<hr class="section-divider" />
<section class="section">
    <h3>2 &nbsp;&nbsp; Azure Enrichment</h3>
    <p class="section-caption">Pull live RI / Savings Plan inventory, Advisor cost recommendations, and Cost Management data.</p>

    @if (State.Records.Count > 0)
    {
        <div class="alert alert-info">
            <strong>Demo Mode</strong> — Simulated RI/SP data will be generated from your invoice file.
        </div>
        <button class="btn btn-primary" @onclick="GenerateDemoData" disabled="@State.IsLoading">
            @if (State.IsLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Generate Demo Data
        </button>
    }
    else
    {
        <div class="alert alert-info">Load an invoice file first (Step 1).</div>
    }
</section>

<!-- ═══════════ Enrichment KPIs ═══════════ -->
@if (State.HasEnrichment)
{
    var rs = State.RecommendationSummary!;
    var ccy = State.Summary?.Currency ?? "USD";
    <div class="kpi-strip">
        <div class="kpi-card"><label>Active Commitments</label><div class="kpi-value">@rs["ActiveCommitments"]</div></div>
        <div class="kpi-card"><label>Expiring ≤ 90 Days</label><div class="kpi-value">@rs["CommitmentsExpiringWithin90Days"]</div></div>
        <div class="kpi-card"><label>Advisor Recommendations</label><div class="kpi-value">@rs["AdvisorCostRecommendationCount"]</div></div>
        <div class="kpi-card"><label>Est. Annual Savings</label><div class="kpi-value">@($"{ccy} {(double)rs["AdvisorEstimatedAnnualSavings"]:N2}")</div></div>
    </div>
}

<!-- ═══════════ Warnings ═══════════ -->
@if (State.Warnings.Count > 0)
{
    <details class="mb-3">
        <summary class="details-summary">⚠️ Azure data warnings</summary>
        @foreach (var w in State.Warnings)
        {
            <div class="alert alert-warning py-1 px-3 mb-1">@w</div>
        }
    </details>
}

<!-- ═══════════ Savings Analysis ═══════════ -->
@if (State.SavingsAnalysis is not null)
{
    var sa = State.SavingsAnalysis;
    var kpi = sa.Kpi;
    var ccy = State.Summary?.Currency ?? "USD";

    <hr class="section-divider" />
    <section class="section">
        <h3>💰 &nbsp; Pay-Go vs RI / SP Savings Projection</h3>
        <p class="section-caption">
            Based on @sa.PeriodDays-day invoice run rate extrapolated to 3 years,
            combined with @kpi.TotalRecommendations Azure Advisor recommendations.
        </p>

        <div class="kpi-strip kpi-strip-5">
            <div class="kpi-card"><label>Current 3-Yr Spend (PAYG)</label><div class="kpi-value">@ccy @kpi.Current3YrSpend.ToString("N2")</div></div>
            <div class="kpi-card"><label>RI/SP 3-Yr Cost</label><div class="kpi-value">@ccy @kpi.RiSp3YrCost.ToString("N2")</div></div>
            <div class="kpi-card"><label>Total 3-Year Savings</label><div class="kpi-value savings-value">@ccy @kpi.Total3YrSavings.ToString("N2")</div></div>
            <div class="kpi-card"><label>Savings %</label><div class="kpi-value savings-value">@kpi.SavingsPercent.ToString("F1")%</div></div>
            <div class="kpi-card"><label>Annual Savings</label><div class="kpi-value savings-value">@ccy @kpi.AnnualSavings.ToString("N2")</div></div>
        </div>

        <div class="tab-bar">
            <button class="tab-btn @(savingsTab == "category" ? "active" : "")" @onclick='() => savingsTab = "category"'>By Resource Type</button>
            <button class="tab-btn @(savingsTab == "region" ? "active" : "")" @onclick='() => savingsTab = "region"'>By Region</button>
            <button class="tab-btn @(savingsTab == "opportunities" ? "active" : "")" @onclick='() => savingsTab = "opportunities"'>Top Opportunities</button>
        </div>

        @if (savingsTab == "category")
        {
            <div class="chart-table-row">
                <div class="chart-col">
                    @{ var catRows = sa.SavingsByCategory.Where(r => r.NetSavings3Yr > 0).Take(15).ToList(); }
                    <BarChart Labels="@catRows.Select(r => r.ResourceType).ToArray()"
                              Data="@catRows.Select(r => r.NetSavings3Yr).ToArray()"
                              ChartLabel="Net Savings (3-Yr)"
                              Color="#27AE60" />
                </div>
                <div class="table-col">
                    <SavingsCategoryTable Rows="sa.SavingsByCategory" Currency="@ccy" />
                </div>
            </div>
        }
        else if (savingsTab == "region")
        {
            <div class="chart-table-row">
                <div class="chart-col">
                    @{ var rgnRows = sa.SavingsByRegion.Where(r => r.NetSavings3Yr > 0).ToList(); }
                    <BarChart Labels="@rgnRows.Select(r => r.Region).ToArray()"
                              Data="@rgnRows.Select(r => r.NetSavings3Yr).ToArray()"
                              ChartLabel="Net Savings (3-Yr)"
                              Color="#27AE60" />
                </div>
                <div class="table-col">
                    <SavingsRegionTable Rows="sa.SavingsByRegion" Currency="@ccy" />
                </div>
            </div>
        }
        else if (savingsTab == "opportunities")
        {
            <TopOpportunitiesTable Rows="sa.TopOpportunities" Currency="@ccy" />
        }
    </section>
}

<!-- ═══════════ Commitment / Advisor Details ═══════════ -->
@if (State.Commitments.Count > 0)
{
    <section class="section">
        <details>
            <summary class="details-summary">Reserved Instances &amp; Savings Plans (@State.Commitments.Count)</summary>
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover">
                    <thead><tr><th>Source</th><th>Name</th><th>Term</th><th>State</th><th>Start</th><th>End</th><th>Days Rem.</th><th>Scope</th></tr></thead>
                    <tbody>
                        @foreach (var c in State.Commitments)
                        {
                            <tr>
                                <td>@c.Source</td><td>@c.Name</td><td>@c.Term</td><td>@c.State</td>
                                <td>@c.StartDate</td><td>@c.EndDate</td><td>@c.DaysRemaining</td><td>@c.Scope</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>
}

@if (State.Recommendations.Count > 0)
{
    <section class="section">
        <details>
            <summary class="details-summary">Advisor Cost Recommendations (@State.Recommendations.Count)</summary>
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover">
                    <thead><tr><th>Category</th><th>Impact</th><th>Description</th><th class="text-end">Annual Savings</th><th>Resource ID</th></tr></thead>
                    <tbody>
                        @foreach (var r in State.Recommendations)
                        {
                            <tr>
                                <td>@r.Category</td><td>@r.Impact</td><td>@r.ShortDescription</td>
                                <td class="text-end">$@r.AnnualSavingsEstimate.ToString("N2")</td>
                                <td class="text-truncate" style="max-width:200px;" title="@r.ResourceId">@r.ResourceId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>
}

<!-- ═══════════ AI Chat Panel ═══════════ -->
<ChatPanel @bind-IsOpen="chatOpen" />

@code {
    private string activeTab = "service";
    private string savingsTab = "category";
    private IBrowserFile? selectedFile;
    private bool chatOpen = false;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        State.ErrorMessage = null;
        State.IsLoading = true;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            State.Records = Loader.LoadInvoiceFile(ms, selectedFile.Name);
            State.FileName = selectedFile.Name;
            Logger.LogInformation("File uploaded: {Name}, {Count} records", selectedFile.Name, State.Records.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load file");
            State.ErrorMessage = $"Failed to load file: {ex.Message}";
        }
        finally
        {
            State.IsLoading = false;
            StateHasChanged();
        }
    }

    private void AnalyzeFile()
    {
        if (State.Records.Count == 0) return;

        State.IsLoading = true;
        State.ErrorMessage = null;
        StateHasChanged();

        try
        {
            var (summary, pivots) = Analysis.Summarise(State.Records);
            State.Summary = summary;
            State.Pivots = pivots;
            Logger.LogInformation("Analysis complete: {Cost:F2} {Ccy}, {Count} records",
                summary.TotalCost, summary.Currency, summary.RecordCount);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Analysis failed");
            State.ErrorMessage = $"Analysis failed: {ex.Message}";
        }
        finally
        {
            State.IsLoading = false;
            StateHasChanged();
        }
    }

    private void GenerateDemoData()
    {
        if (State.Records.Count == 0) return;

        State.IsLoading = true;
        State.ErrorMessage = null;
        StateHasChanged();

        try
        {
            var demo = DemoData.Generate(State.Records);
            State.Recommendations = demo.Recommendations;
            State.Commitments = demo.Commitments;
            State.IsDemoMode = true;

            State.RecommendationSummary = AnalysisService.BuildRecommendationSummary(
                demo.Recommendations, demo.Commitments);

            State.SavingsAnalysis = Analysis.BuildSavingsAnalysis(
                State.Records, demo.Recommendations, demo.FullAnnualPayGo);

            State.Warnings = ["Demo mode — all Azure data is simulated."];
            Logger.LogInformation("Demo data generated: {Recs} recommendations, {Comms} commitments",
                demo.Recommendations.Count, demo.Commitments.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Demo generation failed");
            State.ErrorMessage = $"Demo generation failed: {ex.Message}";
        }
        finally
        {
            State.IsLoading = false;
            StateHasChanged();
        }
    }
}

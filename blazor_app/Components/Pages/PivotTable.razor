@using AzureMaccAnalyst.Models

<div class="table-responsive mt-3">
    <table class="table table-sm table-striped table-hover">
        <thead>
            <tr>
                <th>@LabelHeader</th>
                <th class="text-end">Total Cost</th>
                <th class="text-end">Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td>@row.Label</td>
                    <td class="text-end">@Currency @row.TotalCost.ToString("N2")</td>
                    <td class="text-end">@row.Count.ToString("N0")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td>Total</td>
                <td class="text-end">@Currency @Rows.Sum(r => r.TotalCost).ToString("N2")</td>
                <td class="text-end">@Rows.Sum(r => r.Count).ToString("N0")</td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    [Parameter] public List<PivotRow> Rows { get; set; } = new();
    [Parameter] public string LabelHeader { get; set; } = "Label";
    [Parameter] public string Currency { get; set; } = "USD";
}

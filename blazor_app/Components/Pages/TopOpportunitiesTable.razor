@using AzureMaccAnalyst.Models

<div class="table-responsive mt-3">
    <table class="table table-sm table-striped table-hover">
        <thead>
            <tr>
                <th class="text-center">#</th>
                <th>Resource Type</th>
                <th>SKU</th>
                <th>Region</th>
                <th class="text-end">Current 3-Yr Cost</th>
                <th class="text-end">RI/SP 3-Yr Cost</th>
                <th class="text-end">Net Savings (3 Yr)</th>
                <th class="text-end">Savings %</th>
                <th class="text-end">Annual Savings</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td class="text-center">@row.Rank</td>
                    <td>@row.ResourceType</td>
                    <td><code>@row.Sku</code></td>
                    <td>@row.Region</td>
                    <td class="text-end">@Currency @row.Current3YrCost.ToString("N2")</td>
                    <td class="text-end">@Currency @row.RiSp3YrCost.ToString("N2")</td>
                    <td class="text-end text-success fw-bold">@Currency @row.NetSavings3Yr.ToString("N2")</td>
                    <td class="text-end">@row.SavingsPercent.ToString("N1")%</td>
                    <td class="text-end">@Currency @row.AnnualSavings.ToString("N2")</td>
                    <td class="small">@row.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<TopOpportunityRow> Rows { get; set; } = new();
    [Parameter] public string Currency { get; set; } = "USD";
}

@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="chart-container" style="position:relative; height:@(Height)px; width:100%;">
    <canvas id="@_canvasId"></canvas>
</div>

@code {
    [Parameter] public string[] Labels { get; set; } = Array.Empty<string>();
    [Parameter] public double[] Data { get; set; } = Array.Empty<double>();
    [Parameter] public string ChartLabel { get; set; } = "Cost";
    [Parameter] public string Color { get; set; } = "#0078D4";
    [Parameter] public int Height { get; set; } = 300;
    [Parameter] public string ChartType { get; set; } = "bar"; // "bar" or "line"

    private string _canvasId = $"chart-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Labels.Length > 0 && Data.Length > 0)
        {
            try
            {
                if (ChartType == "line")
                {
                    await JS.InvokeVoidAsync("ChartInterop.renderLineChart",
                        _canvasId, Labels, Data, ChartLabel, Color);
                }
                else
                {
                    await JS.InvokeVoidAsync("ChartInterop.renderBarChart",
                        _canvasId, Labels, Data, ChartLabel, Color);
                }
            }
            catch (JSException)
            {
                // Chart.js not loaded yet — safe to ignore on first render
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ChartInterop.destroyChart", _canvasId);
        }
        catch
        {
            // Component may dispose after circuit disconnect
        }
    }
}

@using AzureMaccAnalyst.Services
@inject CopilotChatService Chat
@implements IDisposable

<div class="chat-overlay @(IsOpen ? "open" : "")">
    <div class="chat-panel">
        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-left">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="currentColor"/>
                </svg>
                <span class="chat-title">Copilot Chat</span>
                @if (Chat.IsConnected)
                {
                    <span class="chat-status connected">Connected</span>
                }
            </div>
            <button class="chat-close-btn" @onclick="Close" title="Close">✕</button>
        </div>

        <!-- Messages -->
        <div class="chat-messages" id="chatMessages">
            @if (!Chat.IsConnected)
            {
                <div class="chat-welcome">
                    <div class="welcome-icon">🤖</div>
                    <h4>Azure MACC Analyst AI</h4>
                    <p>Powered by the GitHub Copilot SDK. Ask questions about your Azure cost data, get spending insights, and explore recommendations.</p>
                    <button class="btn btn-primary btn-connect" @onclick="ConnectAsync" disabled="@Chat.IsBusy">
                        @if (Chat.IsBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Connect to Copilot
                    </button>
                    <small class="mt-2 text-muted d-block">Requires GitHub Copilot CLI and an active subscription.</small>
                </div>
            }
            else
            {
                @foreach (var msg in Chat.Messages)
                {
                    <div class="chat-msg @(msg.Role == "user" ? "user-msg" : "assistant-msg")">
                        <div class="msg-avatar">@(msg.Role == "user" ? "You" : "AI")</div>
                        <div class="msg-bubble">
                            <div class="msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                            <span class="msg-time">@msg.Timestamp.ToString("HH:mm")</span>
                        </div>
                    </div>
                }

                @if (Chat.IsBusy && !string.IsNullOrEmpty(Chat.StreamingContent))
                {
                    <div class="chat-msg assistant-msg">
                        <div class="msg-avatar">AI</div>
                        <div class="msg-bubble streaming">
                            <div class="msg-content">@((MarkupString)FormatContent(Chat.StreamingContent))</div>
                            <span class="typing-indicator">●●●</span>
                        </div>
                    </div>
                }
                else if (Chat.IsBusy)
                {
                    <div class="chat-msg assistant-msg">
                        <div class="msg-avatar">AI</div>
                        <div class="msg-bubble streaming">
                            <span class="typing-indicator">Thinking ●●●</span>
                        </div>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(Chat.ErrorMessage))
            {
                <div class="chat-error">⚠ @Chat.ErrorMessage</div>
            }
        </div>

        <!-- Input -->
        @if (Chat.IsConnected)
        {
            <div class="chat-input-bar">
                <input class="chat-input" type="text"
                       placeholder="Ask about your Azure costs..."
                       @bind="userInput" @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       disabled="@Chat.IsBusy" />
                <button class="chat-send-btn" @onclick="SendMessage"
                        disabled="@(Chat.IsBusy || string.IsNullOrWhiteSpace(userInput))">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor"/>
                    </svg>
                </button>
            </div>
        }
    </div>
</div>

<!-- Floating toggle button -->
<button class="chat-fab @(IsOpen ? "hidden" : "")" @onclick="Toggle" title="Open AI Chat">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z" fill="currentColor"/>
        <path d="M7 9h10v2H7zm0-3h10v2H7z" fill="currentColor"/>
    </svg>
</button>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string userInput = "";

    protected override void OnInitialized()
    {
        Chat.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ConnectAsync()
    {
        await Chat.ConnectAsync();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;
        var prompt = userInput;
        userInput = "";
        await Chat.SendMessageAsync(prompt);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !Chat.IsBusy && !string.IsNullOrWhiteSpace(userInput))
        {
            await SendMessage();
        }
    }

    private void Toggle()
    {
        IsOpen = !IsOpen;
        IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
    }

    private string FormatContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";

        // Basic markdown-like formatting
        content = System.Text.RegularExpressions.Regex.Replace(
            System.Web.HttpUtility.HtmlEncode(content),
            @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        content = System.Text.RegularExpressions.Regex.Replace(
            content, @"`(.+?)`", "<code>$1</code>");
        content = content.Replace("\n", "<br/>");
        return content;
    }

    public void Dispose()
    {
        Chat.OnStateChanged -= HandleStateChanged;
    }
}

@rendermode InteractiveServer
@using AzureMaccAnalyst.Services
@inject AzureAuthService Auth
@inject DashboardState State

<div class="sidebar-brand">
    <!-- Azure logo SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 96 96">
        <defs><linearGradient id="az" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#114A8B"/><stop offset="1" stop-color="#0669BC"/>
        </linearGradient></defs>
        <path fill="url(#az)" d="M33.3 6.5h26.1L32.9 85.3a3.5 3.5 0 0 1-3.3 2.4H9.1a3.5 3.5 0 0 1-3.3-4.6L29.9 8.9a3.5 3.5 0 0 1 3.4-2.4z"/>
        <path fill="#0078D4" d="M71.2 60.8H34.9a1.6 1.6 0 0 0-1.1 2.7l26.2 24.4a3.6 3.6 0 0 0 2.4.9h22.5z"/>
        <path fill="#1490DF" d="M33.3 6.5A3.4 3.4 0 0 0 30 8.8L6 83.1a3.5 3.5 0 0 0 3.3 4.6h21a3.8 3.8 0 0 0 2.9-2.6l5.1-14.9 18 16.8a3.6 3.6 0 0 0 2.2.7h22.3L66.4 52.8l-21.2.1L59.4 6.5z"/>
        <path opacity=".3" fill="#000" d="M59.4 6.5H33.2a3.5 3.5 0 0 0-3.3 2.4l-24 74a3.5 3.5 0 0 0 .7 3.2 3.5 3.5 0 0 1-.7-3.2L30 8.9a3.5 3.5 0 0 1 3.3-2.4z"/>
    </svg>
    <h4 class="brand-title">Azure MACC Analyst</h4>
    <p class="brand-caption">FinOps Cost &amp; Commitment Analysis &middot; v2.1.0</p>
</div>

<hr class="sidebar-divider" />

<!-- ── Connection status ── -->
<div class="sidebar-section">
    @if (Auth.IsSignedIn)
    {
        <span class="status-pill pill-green">● Connected</span>
        @if (!string.IsNullOrEmpty(Auth.UserName) || !string.IsNullOrEmpty(Auth.UserEmail))
        {
            <div class="user-identity">
                <strong>@Auth.UserName</strong><br />
                <span class="user-email">@Auth.UserEmail</span>
            </div>
        }
    }
    else
    {
        <span class="status-pill pill-red">● Not connected</span>
    }
</div>

<div class="sidebar-section sidebar-buttons">
    <button class="sidebar-btn" @onclick="SignInAuto" disabled="@(Auth.IsSignedIn || Auth.IsBusy)">
        @if (Auth.IsBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
        Sign in (auto-detect)
    </button>
    <button class="sidebar-btn" @onclick="SignInInteractive" disabled="@Auth.IsBusy">
        Sign in as different user…
    </button>
    @if (Auth.IsSignedIn)
    {
        <button class="sidebar-btn sidebar-btn-signout" @onclick="SignOut">
            Sign out
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(Auth.ErrorMessage))
{
    <div class="sidebar-section">
        <div class="sidebar-error">@Auth.ErrorMessage</div>
    </div>
}

<hr class="sidebar-divider" />

<div class="sidebar-section">
    <p class="sidebar-hint">
        Authentication uses Microsoft Entra ID.<br />
        No passwords are stored by this app.<br />
        Access governed by your Azure RBAC roles.
    </p>
</div>

<hr class="sidebar-divider" />

<!-- ── Demo Mode toggle ── -->
<div class="sidebar-section">
    <label class="toggle-label">
        <span class="toggle-switch">
            <input type="checkbox" checked="@State.IsDemoMode" @onchange="ToggleDemoMode" />
            <span class="toggle-slider"></span>
        </span>
        Demo Mode
    </label>
    <p class="sidebar-hint" style="margin-top:4px;font-size:.7rem;">
        Simulate RI / SP recommendations &amp; commitments from invoice data (no Azure sign-in required).
    </p>
    @if (State.IsDemoMode)
    {
        <span class="status-pill pill-green" style="margin-top:6px;">● Demo data active</span>
    }
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private async Task SignInAuto()
    {
        await Auth.SignInAutoDetectAsync();
        StateHasChanged();
    }

    private async Task SignInInteractive()
    {
        await Auth.SignInInteractiveAsync();
        StateHasChanged();
    }

    private void SignOut()
    {
        Auth.SignOut();
        StateHasChanged();
    }

    private void ToggleDemoMode(ChangeEventArgs e)
    {
        State.IsDemoMode = (bool)(e.Value ?? false);
        StateHasChanged();
    }
}


# Optional Azure App Registration settings for interactive sign-in
# If AZURE_CLIENT_ID is not provided, the app uses user-context credentials
# (Shared token cache, Azure CLI, Azure Developer CLI, Azure PowerShell, and interactive browser fallback).
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=

# Optional: explicit subscription list (comma-separated)
# If empty, app will discover subscriptions available to signed-in user.
AZURE_SUBSCRIPTION_IDS=

# Optional: API versions if your tenant/cloud requires different versions
AZURE_API_VERSION_COST_QUERY=2024-08-01
AZURE_API_VERSION_ADVISOR=2023-01-01
AZURE_API_VERSION_RESERVATIONS=2022-11-01
AZURE_API_VERSION_SAVINGS_PLANS=2022-11-01

# Optional: Excel size threshold for warning/block behavior (in MB).
# Large .xlsx files are CPU-intensive to parse. Default is 8192 MB.
AZURE_MAX_EXCEL_MB=8192

# Optional: block oversized Excel files when they exceed AZURE_MAX_EXCEL_MB.
# false = warn and continue conversion (recommended when Excel is mandatory)
# true  = stop analysis with a validation error
AZURE_BLOCK_OVERSIZED_EXCEL=false

# Optional: enable/disable the fastexcel (calamine/Rust) fast-path for Excel.
# When enabled AND fastexcel is installed, large xlsx files are parsed 10-50×
# faster (but use more RAM). Automatically falls back to openpyxl streaming
# if the file is too large for available memory, or if fastexcel isn't installed.
AZURE_EXCEL_FAST_PATH=true

# ── Retail Prices API reliability tuning ──────────────────────────────────────

# Per-request HTTP timeout (seconds) for Azure Retail Prices API calls.
# Increase on high-latency or flaky networks. Default: 30.
RETAIL_PRICING_TIMEOUT=30

# Max parallel worker threads for the Advisor-path retail price batch lookup.
# Reduce to lower network pressure on large recommendation sets. Default: 3.
RETAIL_PRICING_MAX_WORKERS=3

# Max parallel worker threads for the CSV RI-detection retail price lookups.
# A lower value reduces transient network errors on large billing exports. Default: 2.
CSV_RI_MAX_PRICE_WORKERS=2

# Optional Azure App Registration settings for interactive sign-in
# If AZURE_CLIENT_ID is not provided, the app uses user-context credentials
# (Shared token cache, Azure CLI, Azure Developer CLI, Azure PowerShell, and interactive browser fallback).
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=

# Optional: explicit subscription list (comma-separated)
# If empty, app will discover subscriptions available to signed-in user.
AZURE_SUBSCRIPTION_IDS=

# Optional: API versions if your tenant/cloud requires different versions
AZURE_API_VERSION_COST_QUERY=2024-08-01
AZURE_API_VERSION_ADVISOR=2023-01-01
AZURE_API_VERSION_RESERVATIONS=2022-11-01
AZURE_API_VERSION_SAVINGS_PLANS=2022-11-01
